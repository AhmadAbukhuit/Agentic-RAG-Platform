# Service Configuration
SERVICE_NAME=agents-service
SERVICE_DESCRIPTION="Agentic RAG & Multi-Agent Orchestration Service"
SERVICE_VERSION=1.0.0

# LangSmith Telemetry & Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-rag-service

# Ollama / Local Model Inference
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
VISION_MODEL=deepseek-ocr
EMBEDDING_MODEL=nomic-embed-text

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=envision_docs

# Redis Distributed Cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=86400
ENABLE_REDIS_CACHE=true

# MongoDB Document Store
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=rag_db
MONGODB_COLLECTION=raw_documents

# Application Security
APP_API_KEY=your_internal_app_api_key
ALLOWED_ORIGINS=*