# Service Configuration
SERVICE_NAME=agents-service
SERVICE_DESCRIPTION="Agentic RAG & Multi-Agent Orchestration Service"
SERVICE_VERSION=1.0.0
PORT=8000

# LangSmith Telemetry & Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-rag-platform

# Optional External Provider (Leave blank when using local Ollama)
OPENAI_API_KEY=

# Ollama / Local Model Inference
# (In Docker, use http://ollama:11434. For local dev outside Docker, use http://localhost:11434)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
LLM_MODEL=llama3
VISION_MODEL=deepseek-ocr
EMBEDDING_MODEL=zylonai/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# Qdrant Vector Database
# (In Docker, use http://qdrant:6333. For local dev outside Docker, use http://localhost:6333)
QDRANT_URL=http://qdrant:6333
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=ahmad_docs

# Redis Distributed Cache
# (In Docker, use redis://redis:6379. For local dev outside Docker, use redis://localhost:6379)
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_CACHE_TTL=86400
ENABLE_REDIS_CACHE=true

# MongoDB Document Store
# (In Docker, use mongodb://mongodb:27017. For local dev outside Docker, use mongodb://localhost:27017)
MONGODB_URL=mongodb://mongodb:27017
MONGODB_PORT=27017
MONGODB_DATABASE=platform_db
MONGODB_COLLECTION=raw_documents

# Application Security & CORS
APP_API_KEY=
ALLOWED_ORIGINS=*